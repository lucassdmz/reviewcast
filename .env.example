# Copiez ce fichier en .env et renseignez les valeurs. Ne commitez jamais .env.

# --- Base de données -------------------------------------------------------
# Postgres local (docker compose up -d) ou chaîne de connexion Supabase
# (Project settings > Database > Connection string, mode "session").
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eclaircie"

# --- Authentification (Auth.js) -------------------------------------------
# Secret de signature des cookies : `openssl rand -base64 32`
AUTH_SECRET=""
# URL publique de l'application (http://localhost:3000 en local).
AUTH_URL="http://localhost:3000"
# Identifiants OAuth du projet Google Cloud (écran OAuth, type « application web »).
# URI de redirection autorisée : {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Adresses e-mail autorisées à se connecter, séparées par des virgules.
# V1 : un seul utilisateur.
ALLOWED_EMAILS="vous@exemple.fr"

# --- Chiffrement des secrets en base --------------------------------------
# Clé AES-256 encodée en base64 (32 octets) : `openssl rand -base64 32`
# Sert à chiffrer les refresh tokens Google et les clés IA avant stockage.
ENCRYPTION_KEY=""

# --- Intelligence artificielle --------------------------------------------
# Clé Anthropic par défaut (peut aussi être saisie dans Réglages, stockée chiffrée).
ANTHROPIC_API_KEY=""
# Mettez "fake" pour utiliser le fournisseur simulé, sans clé ni réseau
# (développement local, données de démonstration).
AI_PROVIDER=""
# Avec le fournisseur simulé uniquement : temps de réponse imité, en millisecondes.
AI_FAKE_DELAI_MS=""

# --- Publication Google ----------------------------------------------------
# Mettez "simulee" pour enregistrer les réponses en base sans appeler Google
# (démonstration, tests). Vide = publication réelle via le compte connecté.
PUBLICATION_GOOGLE=""

# --- Connexion de la fiche Google (lot 1) ------------------------------------
# La fiche se connecte avec les mêmes identifiants OAuth que AUTH_GOOGLE_ID et
# AUTH_GOOGLE_SECRET. Ajoutez une seconde URI de redirection autorisée au client :
# {AUTH_URL}/api/google/callback
#
# Notifications en temps réel (Cloud Pub/Sub). Vides : pas de temps réel, l'ouverture
# de l'app et le passage quotidien synchronisent quand même. Toutes les trois vont ensemble.
# Sujet Pub/Sub : projects/eclaircie-513015/topics/<nom>
GOOGLE_PUBSUB_TOPIC=""
# Audience configurée sur l'abonnement push (--push-auth-token-audience).
GOOGLE_PUBSUB_AUDIENCE=""
# Compte de service configuré sur l'abonnement push (--push-auth-service-account).
GOOGLE_PUBSUB_SERVICE_ACCOUNT=""
#
# Faux serveur Google des tests (tests/fake-google). À laisser vides partout ailleurs :
# elles sont ignorées en production Vercel.
GOOGLE_API_BASE_URL=""
GOOGLE_OAUTH_BASE_URL=""
GOOGLE_OIDC_JWKS_URL=""

# --- Démonstration ----------------------------------------------------------
# Mettez "1" pour ouvrir l'application sans connexion (démo partagée par lien).
# Exige PUBLICATION_GOOGLE="simulee". Ne jamais activer avec de vraies fiches.
MODE_DEMO=""

# --- Notifications push (lot 6) ---------------------------------------------
# Clés VAPID : `npx web-push generate-vapid-keys`. Vides = notifications indisponibles.
# La clé privée ne quitte jamais le serveur ; la clé publique est donnée au navigateur.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact présenté aux services de push (Apple, Google, Mozilla) : mailto: ou https://
VAPID_SUJET="mailto:vous@exemple.fr"

# --- Tâches planifiées -------------------------------------------------------
# Secret présenté par le cron (en-tête Authorization: Bearer …) aux routes
# /api/taches/* : `openssl rand -base64 32`. Vercel le transmet de lui-même.
CRON_SECRET=""

# --- Bêta : bulle de remarques -----------------------------------------------
# "1" affiche sur tous les écrans une bulle où le testeur écrit ce qui ne va pas.
# Remarques relues avec `npm run retours`. Ne jamais activer chez un client.
RETOURS_BETA=""
