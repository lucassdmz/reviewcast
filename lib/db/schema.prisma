// Schéma de données — section 5.2 du cahier des charges.
// Les tables d'authentification (users, accounts, sessions, verification_tokens)
// sont celles attendues par l'adaptateur Prisma d'Auth.js.

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Authentification (Auth.js)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts          Account[]
  sessions          Session[]
  googleConnections GoogleConnection[]
  auditLogs         AuditLog[]
  pushAbonnements   PushAbonnement[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Connexion Google Business Profile (lot 1)
// ---------------------------------------------------------------------------

/// Compte Google autorisé pour la Business Profile API. Le refresh token est
/// chiffré en AES-256-GCM avec la clé ENCRYPTION_KEY (voir lib/crypto).
model GoogleConnection {
  id                    String   @id @default(cuid())
  userId                String   @map("user_id")
  googleAccountId       String   @unique @map("google_account_id")
  googleAccountName     String?  @map("google_account_name")
  refreshTokenEncrypted String   @map("refresh_token_encrypted")
  scope                 String
  /// Google a refusé le renouvellement du jeton (accès retiré) : la gérante doit reconnecter sa fiche.
  aReconnecterAt        DateTime? @map("a_reconnecter_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  locations Location[]

  @@map("google_connections")
}

// ---------------------------------------------------------------------------
// Données métier
// ---------------------------------------------------------------------------

/// Statut interne d'un avis dans la file « À traiter ».
enum ReviewStatus {
  HORS_FILE
  A_TRAITER
  BROUILLON_PRET
  PUBLIE
  IGNORE

  @@map("review_status")
}

enum Sentiment {
  POSITIF
  NEUTRE
  MIXTE
  NEGATIF

  @@map("sentiment")
}

enum Gravite {
  FAIBLE
  MOYENNE
  FORTE

  @@map("gravite")
}

enum Polarite {
  POSITIF
  NEGATIF
  MIXTE

  @@map("polarite")
}

enum OrigineTheme {
  TAXONOMIE
  IA

  @@map("origine_theme")
}

enum Meteo {
  GRAND_SOLEIL
  SOLEIL_VOILE
  NUAGEUX
  PLUIE_LEGERE

  @@map("meteo")
}

enum FournisseurIa {
  ANTHROPIC
  OPENAI
  OLLAMA

  @@map("fournisseur_ia")
}

/// Personne qui parle dans les réponses (section 12 du cdc).
enum Personne {
  JE
  NOUS

  @@map("personne")
}

enum Registre {
  SOBRE
  CHALEUREUX
  COMPLICE

  @@map("registre")
}

enum Longueur {
  COURTE
  MOYENNE

  @@map("longueur")
}

/// Fiche Google (établissement).
model Location {
  id                 String   @id @default(cuid())
  googleLocationId   String   @unique @map("google_location_id")
  googleConnectionId String   @map("google_connection_id")
  nom                String
  adresse            String?
  /// Logo affiché dans la barre d'onglets et dans la liste des établissements.
  logo               Bytes?
  logoType           String?  @map("logo_type")
  /// Compte Google par lequel lire la fiche (accounts/{id}). Null pour les données de démonstration.
  googleCompte       String?  @map("google_compte")
  /// Dernière synchronisation terminée.
  lastSyncAt         DateTime? @map("last_sync_at")
  /// Dernière requête de liste réservée : sert de verrou pour la limite de 15 minutes.
  derniereListeAt    DateTime? @map("derniere_liste_at")
  /// Notifications en temps réel : « actives », « autre_sujet » (le compte publie déjà vers un autre sujet), ou null.
  notificationsGoogle String?  @map("notifications_google")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  googleConnection GoogleConnection @relation(fields: [googleConnectionId], references: [id], onDelete: Cascade)
  reviews          Review[]
  monthlySummaries MonthlySummary[]
  synthesesPeriode SynthesePeriode[]
  settings         Settings?
  dailyStats       DailyStat[]
  themeStats       ThemeStat[]
  corrections      Correction[]
  lotsAnalyse      LotAnalyse[]
  constatsVus      ConstatVu[]

  @@map("locations")
}

/// Avis Google. Jamais effacé : un avis retiré côté Google est marqué `retireAt`.
model Review {
  id                 String       @id @default(cuid())
  googleReviewId     String       @unique @map("google_review_id")
  locationId         String       @map("location_id")
  auteur             String
  note               Int
  texte              String?
  dateCreation       DateTime     @map("date_creation")
  dateMaj            DateTime     @map("date_maj")
  reponseGoogleTexte String?      @map("reponse_google_texte")
  reponseGoogleDate  DateTime?    @map("reponse_google_date")
  statut             ReviewStatus @default(HORS_FILE)
  retireAt           DateTime?    @map("retire_at")
  // Notification « avis à traiter » déjà envoyée pour cet avis (lot 6).
  notifieAt          DateTime?    @map("notifie_at")
  /// Avis nouveau ou modifié, pas encore passé par l'IA : l'import reprend là où il s'est arrêté.
  analyseAFaire      Boolean      @default(false) @map("analyse_a_faire")
  /// Réservation de l'analyse par un passage, pour ne jamais payer deux fois le même appel.
  analyseReserveeAt  DateTime?    @map("analyse_reservee_at")
  /// Avis de l'import initial : son analyse passe par la Batch API, pas par un appel unitaire.
  analyseEnLot       Boolean      @default(false) @map("analyse_en_lot")
  /// Réservation de la rédaction du merci, pour ne jamais payer deux fois le même appel.
  merciReserveAt     DateTime?    @map("merci_reserve_at")
  lotAnalyseId       String?      @map("lot_analyse_id")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  location Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  lotAnalyse LotAnalyse?     @relation(fields: [lotAnalyseId], references: [id], onDelete: SetNull)
  analysis ReviewAnalysis?
  drafts   Draft[]
  notes    Note[]
  correction Correction?

  @@index([locationId, dateCreation])
  @@index([locationId, statut])
  @@index([locationId, analyseAFaire])
  @@index([lotAnalyseId])
  @@map("reviews")
}

enum StatutLot {
  PREPARATION
  EN_COURS
  TERMINE
  ABANDONNE

  @@map("statut_lot")
}

/// Lot d'analyses soumis à la Batch API pendant l'import initial d'une fiche.
model LotAnalyse {
  id            String    @id @default(cuid())
  locationId    String    @map("location_id")
  /// Identifiant chez le fournisseur. Null tant que la soumission n'a pas abouti.
  idFournisseur String?   @map("id_fournisseur")
  statut        StatutLot @default(PREPARATION)
  nbAvis        Int       @map("nb_avis")
  /// Dernier relevé, qui sert aussi de verrou entre passages simultanés.
  releveLe      DateTime? @map("releve_le")
  termineLe     DateTime? @map("termine_le")
  createdAt     DateTime  @default(now()) @map("created_at")

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  avis     Review[]

  @@index([locationId, statut])
  @@map("lots_analyse")
}

/// Résultat de l'analyse IA d'un avis (sortie JSON validée par zod).
model ReviewAnalysis {
  id            String    @id @default(cuid())
  reviewId      String    @unique @map("review_id")
  sentiment     Sentiment
  gravite       Gravite?
  resume        String
  passagesCles  String[]  @map("passages_cles")
  /// Vrai si l'IA détecte un problème concret (sert à inclure un avis 4 étoiles dans la file).
  problemeDetecte Boolean @default(false) @map("probleme_detecte")
  /// Avis manifestement faux ou hors sujet (section 4.2 du cdc).
  horsSujet     Boolean   @default(false) @map("hors_sujet")
  modele        String
  createdAt     DateTime  @default(now()) @map("created_at")

  review Review                @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  themes ReviewAnalysisTheme[]

  @@map("review_analyses")
}

/// Thèmes détectés sur une analyse (liste ordonnée, avec le passage surligné).
/// `polarite` est celle de l'avis sur ce thème, pas celle du thème en général.
model ReviewAnalysisTheme {
  analysisId String   @map("analysis_id")
  themeId    String   @map("theme_id")
  polarite   Polarite @default(MIXTE)
  passage    String?

  analysis ReviewAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  theme    Theme          @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([analysisId, themeId])
  @@map("review_analysis_themes")
}

/// Brouillon de réponse généré par l'IA. Chaque régénération crée une version.
model Draft {
  id         String   @id @default(cuid())
  reviewId   String   @map("review_id")
  texte      String
  version    Int
  consigne   String?
  /// Réglages de la voix au moment de l'écriture, pour savoir si le brouillon les suit encore. Null avant ce suivi.
  reglages   Json?
  /// « reglages » quand l'application l'a réécrit après un changement de réglages.
  motif      String?
  modele     String
  tokensIn   Int      @default(0) @map("tokens_in")
  tokensOut  Int      @default(0) @map("tokens_out")
  createdAt  DateTime @default(now()) @map("created_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, version])
  @@map("drafts")
}

/// Fiche de constat déjà vue sur l'accueil : elle ne revient pas avant son délai, sauf si le sujet s'aggrave.
model ConstatVu {
  locationId String   @map("location_id")
  cle        String
  /// Mesure de la fiche quand elle a été vue (nombre d'avis pour un sujet qui monte).
  nombre     Int
  vuAt       DateTime @map("vu_at")

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([locationId, cle])
  @@map("constats_vus")
}

/// Taxonomie des thèmes (accueil, délais, qualité…), extensible par l'IA.
model Theme {
  id        String       @id @default(cuid())
  libelle   String       @unique
  polarite  Polarite
  origine   OrigineTheme @default(TAXONOMIE)
  createdAt DateTime     @default(now()) @map("created_at")

  analyses   ReviewAnalysisTheme[]
  themeStats ThemeStat[]

  @@map("themes")
}

// ---------------------------------------------------------------------------
// Statistiques précalculées (section 7 : jamais calculées à l'affichage)
// ---------------------------------------------------------------------------

/// Agrégat quotidien par établissement, reconstruit à chaque analyse ou publication.
model DailyStat {
  id                  String   @id @default(cuid())
  locationId          String   @map("location_id")
  jour                DateTime @db.Date
  volume              Int
  sommeNotes          Int      @map("somme_notes")
  nb1                 Int      @default(0)
  nb2                 Int      @default(0)
  nb3                 Int      @default(0)
  nb4                 Int      @default(0)
  nb5                 Int      @default(0)
  /// Avis 1 à 3 étoiles reçus ce jour-là.
  nbNegatifs          Int      @default(0) @map("nb_negatifs")
  /// Parmi eux, ceux qui ont une réponse publiée.
  nbNegatifsRepondus  Int      @default(0) @map("nb_negatifs_repondus")
  /// Somme des délais de réponse (heures) des avis négatifs répondus.
  sommeDelaiHeures    Decimal  @default(0) @map("somme_delai_heures") @db.Decimal(12, 2)
  updatedAt           DateTime @updatedAt @map("updated_at")

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, jour])
  @@map("daily_stats")
}

/// Nombre d'avis par jour, thème et polarité détectée.
model ThemeStat {
  id         String   @id @default(cuid())
  locationId String   @map("location_id")
  jour       DateTime @db.Date
  themeId    String   @map("theme_id")
  polarite   Polarite
  nombre     Int

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  theme    Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([locationId, jour, themeId, polarite])
  @@index([locationId, jour])
  @@map("theme_stats")
}

/// Synthèse mensuelle précalculée pour la home et la page Tendances.
/// `locationId` null = vue globale de tous les établissements.
/// Synthèse de Tendances d'une période réelle (du… au…), jamais écrasée par une autre période.
model SynthesePeriode {
  id         String    @id @default(cuid())
  /// `fiche:<id>`, ou `ensemble:<empreinte des fiches>` pour une vue d'ensemble : celle d'un compte n'est jamais montrée à un autre.
  portee     String
  locationId String?   @map("location_id")
  debut      DateTime  @db.Date
  /// Exclue, comme dans le calcul de la période.
  fin        DateTime  @db.Date
  libelle    String
  /// Empreinte des chiffres racontés : tant qu'elle ne change pas, le texte n'est pas repayé.
  empreinte  String?
  texte      String?
  /// Rédaction en cours, pour ne jamais payer deux fois le même appel.
  reserveeAt DateTime? @map("reservee_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([portee, debut, fin])
  @@index([portee, empreinte])
  @@index([portee, libelle])
  @@index([locationId])
  @@map("syntheses_periode")
}

model MonthlySummary {
  id          String   @id @default(cuid())
  locationId  String?  @map("location_id")
  mois        DateTime @db.Date
  /// Phrase météo de la home (une ligne, générée par l'IA).
  phrase      String?
  /// Synthèse mensuelle de la page Tendances (5 lignes maximum).
  texte       String?
  meteo       Meteo
  noteMoyenne Decimal  @map("note_moyenne") @db.Decimal(3, 2)
  volume      Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, mois])
  @@map("monthly_summaries")
}

/// Réglages par établissement. Les clés IA sont chiffrées (lib/crypto).
model Settings {
  id                     String        @id @default(cuid())
  locationId             String        @unique @map("location_id")
  ligneDeConduite        String?       @map("ligne_de_conduite")
  exemplesReference      String[]      @map("exemples_reference")
  seuilGrandSoleilNote   Decimal       @default(4.7) @map("seuil_grand_soleil_note") @db.Decimal(3, 2)
  seuilGrandSoleilPart   Int           @default(90) @map("seuil_grand_soleil_part")
  seuilSoleilVoileNote   Decimal       @default(4.3) @map("seuil_soleil_voile_note") @db.Decimal(3, 2)
  seuilNuageuxNote       Decimal       @default(3.8) @map("seuil_nuageux_note") @db.Decimal(3, 2)
  inclureQuatreEtoiles   Boolean       @default(true) @map("inclure_quatre_etoiles")
  fournisseurIa          FournisseurIa @default(ANTHROPIC) @map("fournisseur_ia")
  modeleAnalyse          String?       @map("modele_analyse")
  modeleRedaction        String?       @map("modele_redaction")
  cleIaChiffree          String?       @map("cle_ia_chiffree")
  notificationsActives   Boolean       @default(false) @map("notifications_actives")
  /// Voix de l'établissement : signature ajoutée par l'application à chaque réponse.
  signature              String?
  personne               Personne      @default(NOUS)
  registre               Registre      @default(CHALEUREUX)
  longueur               Longueur      @default(COURTE)
  /// Ancien réglage oui / non, remplacé par `emojisAutorises`. Colonne conservée : sa suppression est laissée à une migration lancée à la main.
  emojis                 Boolean       @default(false)
  /// Emojis que l'IA a le droit d'utiliser (6 au plus). Vide : aucun emoji.
  emojisAutorises        String[]      @default([]) @map("emojis_autorises")
  /// Retenir les réponses réécrites avant publication comme modèles pour la suite.
  apprendreCorrections   Boolean       @default(true) @map("apprendre_corrections")
  /// E-mail ou téléphone à proposer pour poursuivre l'échange.
  contact                String?
  /// Règles par sujet : [{ sujet, themes, dire, nePasDire }]. Null tant que l'établissement n'y a pas touché.
  reglesSujets           Json?         @map("regles_sujets")
  motsEvites             String[]      @default([]) @map("mots_evites")
  /// Lien « Laisser un avis » de la fiche Google, pour le QR du comptoir. Saisi dans Réglages en attendant la synchronisation.
  lienAvis               String?       @map("lien_avis")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@map("settings")
}

/// Réponse réécrite par la gérante avant publication, retenue comme modèle.
model Correction {
  id         String   @id @default(cuid())
  reviewId   String   @unique @map("review_id")
  locationId String   @map("location_id")
  /// Brouillon proposé par l'IA, sans signature.
  brouillon  String
  /// Version publiée, sans signature.
  texte      String
  createdAt  DateTime @default(now()) @map("created_at")

  review   Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId, createdAt])
  @@map("corrections")
}

/// Note interne privée sur un avis (donnée personnelle, exportable et supprimable).
model Note {
  id        String   @id @default(cuid())
  reviewId  String   @map("review_id")
  texte     String
  createdAt DateTime @default(now()) @map("created_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("notes")
}

/// Consommation IA par appel, pour le compteur de tokens des Réglages (section 4.3).
model AiUsage {
  id          String   @id @default(cuid())
  tache       String
  modele      String
  tokensIn    Int      @map("tokens_in")
  tokensOut   Int      @map("tokens_out")
  cacheRead   Int      @default(0) @map("cache_read")
  cacheWrite  Int      @default(0) @map("cache_write")
  batch       Boolean  @default(false)
  coutEstime  Decimal  @map("cout_estime") @db.Decimal(10, 6)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("ai_usage")
}

/// Journal des actions sensibles (section 7) : publication, ligne de conduite, clé API.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  cible     String?
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("audit_logs")
}

// Lot 6 : un abonnement aux notifications push par appareil, avec ses choix.
model PushAbonnement {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  endpoint    String   @unique
  p256dh      String
  auth        String
  nouvelAvis  Boolean  @default(true) @map("nouvel_avis")
  resumeHebdo Boolean  @default(true) @map("resume_hebdo")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// Remarque laissée par un testeur de la bêta depuis la bulle de retours,
/// rattachée à l'écran où elle a été écrite. Lue par l'équipe avec `npm run retours`.
model RetourBeta {
  id            String    @id @default(cuid())
  /// Adresse exacte de l'écran (chemin et paramètres).
  chemin        String
  /// Gabarit de l'écran (`/a-traiter/[id]`) : regroupe les remarques d'un même écran.
  gabarit       String
  /// Nom lisible de l'écran (« Fiche d'un avis »).
  ecran         String
  texte         String
  /// Identifiant aléatoire de l'appareil du testeur : regroupe ses remarques sans le nommer.
  appareil      String
  /// Établissement affiché au moment de la remarque (nom figé).
  etablissement String?
  /// Élément montré du doigt : sélecteur, texte, rôle, position.
  element       Json?
  /// Taille d'écran, thème, version déployée, navigateur.
  contexte      Json
  capture       Bytes?
  captureType   String?   @map("capture_type")
  /// ouvert, traite ou ecarte.
  statut        String    @default("ouvert")
  /// Ce qui a été fait, montré au testeur dans la bulle.
  reponse       String?
  /// Commit qui corrige la remarque.
  commit        String?
  traiteLe      DateTime? @map("traite_le")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([statut, gabarit])
  @@index([chemin])
  @@map("retours_beta")
}
